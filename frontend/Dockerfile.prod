# Production build: compiles the Vite app to static files, then serves
# them with nginx. The local-dev Dockerfile (Dockerfile) runs the Vite
# dev server instead — this file is only for going live.

# --- Stage 1: build the static assets ---
FROM node:20-alpine AS build

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm install

COPY . .

# VITE_API_BASE_URL is baked into the static build at build time (Vite
# resolves import.meta.env.* during `vite build`), so it must be passed
# as a build arg pointing at the backend's real public URL.
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# --- Stage 2: serve the built assets ---
FROM nginx:1.27-alpine

COPY --from=build /usr/src/app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
