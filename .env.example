# Used by docker-compose.yml for variable substitution.
# Copy to `.env` in the repo root and fill in real values before running
# `docker compose up`.

PGDATABASE=joineazy
PGUSER=joineazy_user
PGPASSWORD=change_me

# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_COOKIE_MAX_AGE_MS=86400000

# Max members (including the leader) allowed in a student group
GROUP_MAX_MEMBERS=4

# --- Only needed for docker-compose.prod.yml (live deployment) ---
# Your live frontend's public URL (used for CORS on the backend).
CLIENT_ORIGIN=https://your-frontend-domain.com
# Your live backend's public URL + /api (baked into the frontend build).
VITE_API_BASE_URL=https://your-backend-domain.com/api
